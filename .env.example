S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CUSTOM_DOMAIN=""
S3_SOURCE_POINT=

# API AUTH Key
AUTH_SECRET=

